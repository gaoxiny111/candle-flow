[Unit]
Description=Candle Flow
After=network.target

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/candle-flow/backend
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/candle-flow/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8002
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
